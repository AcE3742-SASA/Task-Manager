{
  "name": "sasa-task-manager",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 5183 --strictPort",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "preview:demo": "vite preview --outDir dist-demo --host 127.0.0.1 --port 4183 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@samasante/liquid-glass": "0.1.1",
    "firebase": "^11.1.0",
    "firebase-admin": "^14.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.11",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
