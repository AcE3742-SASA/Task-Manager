# Firebase 웹 앱 설정. 콘솔 → 프로젝트 설정 → 내 앱 → SDK 설정에서 그대로 복사한다.
# 이 값들은 비밀이 아니다 (클라이언트 번들에 그대로 실린다). 접근 제어는 Firebase 보안 규칙이 한다.
# 로컬은 이 파일을 .env.local 로 복사해 채우고, 배포는 Vercel 환경변수에 같은 이름으로 넣는다.

VITE_FIREBASE_API_KEY=
# ⚠️ 배포 도메인을 그대로 쓴다 (예: sasa-task-manager.vercel.app).
# *.firebaseapp.com 을 쓰면 iOS 홈 화면 PWA에서 로그인이 깨진다 — docs/setup-firebase-vercel.md 참조.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 웹 푸시 공개키. npx web-push generate-vapid-keys 로 만든 publicKey 를 그대로 넣는다.
# 비밀키는 여기가 아니라 Vercel 환경변수(VAPID_PRIVATE)에만 둔다.
VITE_VAPID_PUBLIC=
