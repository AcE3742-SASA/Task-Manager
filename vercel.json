{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "NODE_OPTIONS": "--experimental-require-module"
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://sasa-task-manager.firebaseapp.com/__/auth/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
